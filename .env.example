# Core
DATABASE_URL=postgresql://archon:archon_dev_password@localhost:5433/archon
# JWT signing (EdDSA). Leave both blank in development: every process derives the
# same publicly-known keypair from a seed in jwt_config.py. Outside development
# both the app and the public API refuse to boot on it — generate a pair with
# `just jwt-keys`, give the app the private half (SECRET, ansible-vault) and every
# verifier the public one. JWT_PUBLIC_KEYS takes several, space-separated, so a
# rotation does not invalidate live sessions.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEYS=
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
SNAPSHOT_DIR=/tmp/archon_snapshots

# WebAuthn/Passkey
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Archon
WEBAUTHN_ORIGIN=http://localhost:5173

# Discord OAuth
DISCORD_CLIENTID=your_discord_client_id
DISCORD_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback
# Discord Linked Roles (optional — registers metadata on startup)
DISCORD_BOT_TOKEN=your_discord_bot_token

# GitHub OAuth App (profile account-linking — lets feedback issues @-mention the
# reporter). A user-facing OAuth App, separate from the GitHub *Apps* below.
# Unset CLIENT_ID -> the "Link GitHub" button errors (feature simply unavailable).
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_SECRET=your_github_oauth_client_secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Email (Magic Link)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=noreply@archon.example.com
MAIL_USE_TLS=true

# VEKN Integration
VEKN_SYNC_ENABLED=false
VEKN_SYNC_INTERVAL_HOURS=6
TWDA_SYNC_ENABLED=false
VEKN_API_BASE_URL=https://www.vekn.net/api
VEKN_API_USERNAME=your_vekn_username
VEKN_API_PASSWORD=your_vekn_password
VEKN_PUSH=false
VEKN_PUSH_INTERVAL_HOURS=1
VITE_VEKN_PUSH=

# TWDA GitHub App (auto-PR to GiottoVerducci/TWD)
TWDA_GITHUB_CLIENT_ID=your_github_app_client_id
TWDA_GITHUB_PRIVATE_KEY=path/to/private-key.pem
TWDA_GITHUB_INSTALLATION_ID=get_once_installed
TWDA_GITHUB_FORK_INSTALLATION_ID=get_once_installed
TWDA_GITHUB_FORK_OWNER=vtes-biased

# In-app feedback -> GitHub issues. Dedicated GitHub App (separate from TWDA's),
# Issues:write, installed only on vtes-biased/archon-vibe. Any unset -> the
# /api/feedback endpoint returns 503 (disabled). PRIVATE_KEY is inline PEM or a
# path to the .pem file.
FEEDBACK_GITHUB_CLIENT_ID=your_github_app_client_id
FEEDBACK_GITHUB_PRIVATE_KEY=path/to/feedback-private-key.pem
FEEDBACK_GITHUB_INSTALLATION_ID=get_once_installed

# Web Push (#314) — generate with `just vapid-keys` (one keypair per environment).
# Private key + subject are SECRET (ansible-vault, never commit). The public key is
# served per-env by GET /api/push/vapid-key. Leave blank to disable push (no-op).
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@archon.example.com
