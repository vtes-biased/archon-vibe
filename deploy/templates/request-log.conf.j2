# map and log_format only exist in the http context, hence conf.d and not the vhost.
# One map per parameter, each reading the previous: a map rewrites one match.
{% for source in ("request", "http_referer") %}
{% set ns = namespace(prev="$" ~ source) %}
{% for param in ("token", "code", "state") %}
map {{ ns.prev }} ${{ log_format }}_{{ source }}_{{ param }} {
  "~^(?<{{ param }}_head>.*[?&]{{ param }}=)[^& ]*(?<{{ param }}_tail>.*)$" "${{ '{' }}{{ param }}_head}***${{ '{' }}{{ param }}_tail}";
  default {{ ns.prev }};
}
{% set ns.prev = "$" ~ log_format ~ "_" ~ source ~ "_" ~ param %}
{% endfor %}
{% endfor %}
log_format {{ log_format }} '$remote_addr - $remote_user [$time_local] "${{ log_format }}_request_state" $status $body_bytes_sent "${{ log_format }}_http_referer_state" "$http_user_agent" $request_id';
