{% include "http.j2" %}

server {
{% include "tls.j2" %}

  client_max_body_size 1k;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Frame-Options "DENY" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  # The streams are the bulk of the egress and go out uncompressed without this;
  # gzip_proxied defaults to off, which would skip every proxied response.
  gzip on;
  gzip_vary on;
  gzip_proxied any;
  gzip_min_length 1024;
  gzip_types application/json application/x-ndjson application/vnd.oai.openapi+json;

  limit_conn {{ zone }}_conn 16;
  # nginx defaults both to 503, which tells a client "outage, retry" rather than
  # "slow down".
  limit_req_status 429;
  limit_conn_status 429;

  # Inherited by every location below: a location that declares any
  # proxy_set_header of its own drops all of these.
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Host $http_host;
  proxy_set_header X-Request-ID $request_id;
  proxy_http_version 1.1;
  # Taking the first N lines and hanging up is the documented top-N idiom;
  # buffering would make that reader wait for the whole corpus.
  proxy_buffering off;
  proxy_read_timeout 300s;

  location = / {
    return 302 /docs;
  }

  # Proxied to the app, at the app's own path: a third party never types a
  # second hostname, and a rewritten path here would drift from `banner_path`.
{% for path in ("= /oauth/token", "= /oauth/revoke") %}
  location {{ path }} {
    limit_req zone={{ zone }}_token burst=5 nodelay;
    proxy_pass http://127.0.0.1:{{ backend_port }};
  }
{% endfor %}
  location ~ ^/api/tournaments/[0-9a-fA-F-]+/banner$ {
    limit_req zone={{ zone }}_read burst=100 nodelay;
    proxy_pass http://127.0.0.1:{{ backend_port }};
  }

{% for path in ("/docs", "/openapi.json") %}
  location = {{ path }} {
    limit_req zone={{ zone }}_read burst=100 nodelay;
    proxy_pass http://127.0.0.1:{{ api_port }};
  }
{% endfor %}

  location /v1/ {
    limit_req zone={{ zone }}_v1 burst=500 nodelay;
    proxy_pass http://127.0.0.1:{{ api_port }};
  }

  location / {
    return 404;
  }
}
