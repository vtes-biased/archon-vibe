[Unit]
Description={{ unit }}-backend (archon FastAPI backend)
After=network-online.target {{ postgres_unit }} {{ unit }}-backend.socket
Requires={{ unit }}-backend.socket
Wants=network-online.target

[Service]
Type=simple
User={{ name }}
Group={{ name }}
WorkingDirectory={{ backend_root }}
EnvironmentFile={{ env_dir }}/{{ unit }}-backend.env
ExecStart={{ backend_root }}/.venv/bin/uvicorn --fd 3 --log-level info --timeout-graceful-shutdown 5 backend.src.main:app
# A 200-client burst costs a socket plus a snapshot fd per client, under 2x
# headroom at the 1024 default — running out truncates responses mid-body.
LimitNOFILE=65536
Restart=always
RestartSec=3
TimeoutStartSec=30
# Daily restart: primarily to re-fetch upstream assets loaded at startup
# (krcg-static card data) without a redeploy; also a low-key memory-leak defense.
RuntimeMaxSec=1d
# Bounds the worst case if a connection ignores both SIGTERM and the 5s
# graceful-shutdown drain (was a ~90s hang via the default 90s TimeoutStopSec).
TimeoutStopSec=15
KillMode=mixed

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths={{ backend_root }} {{ lib_dir }}

[Install]
WantedBy=multi-user.target
