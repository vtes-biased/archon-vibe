# Stage 1: Build WASM engine (same as production Dockerfile)
FROM rust:slim AS wasm-builder
# Prebuilt wasm-pack via cargo-binstall instead of `cargo install` (which compiles
# it from source, ~minutes). wasm-pack ships musl binaries for x86_64 AND aarch64
# linux, so this is fast on CI (x86_64) and local arm64 builds alike; binstall
# falls back to a source build only if a prebuilt is ever missing.
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    rustup target add wasm32-unknown-unknown && \
    curl -L --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash && \
    cargo binstall -y wasm-pack
WORKDIR /engine
COPY engine/ .
RUN wasm-pack build --no-opt --target web --release --features wasm

# Stage 2: Test runner with Playwright
FROM node:24-slim
WORKDIR /app

# Install Playwright system dependencies and curl
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 \
    libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 \
    libxrandr2 libgbm1 libasound2 curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Copy WASM engine output to where the $engine alias resolves
COPY --from=wasm-builder /engine/pkg /engine/pkg

# Install dependencies
COPY frontend/package*.json ./
RUN npm ci

# Install Playwright browsers
RUN npx playwright install --with-deps chromium

# Copy frontend source
COPY frontend/ ./

# Fix geonames: copy actual files instead of broken symlink
RUN rm -rf src/lib/data/geonames
COPY backend/src/data/geonames/ src/lib/data/geonames/

# Wait for backend, start dev server (skip npm setup — geonames copied at
# build time), and run tests. Backend host comes from VITE_API_URL so it
# tracks the compose wiring (backend-test in the isolated test profile).
CMD ["sh", "-c", "\
    echo \"Waiting for backend at ${VITE_API_URL}...\" && \
    timeout 60 sh -c 'until curl -sf ${VITE_API_URL}/ > /dev/null; do sleep 1; done' && \
    echo 'Backend ready. Starting Vite dev server...' && \
    npx vite dev --host 0.0.0.0 & \
    sleep 5 && \
    echo 'Running Playwright tests...' && \
    BASE_URL=http://localhost:5173 npm run test:e2e \
    "]
