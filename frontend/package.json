{
  "name": "archon-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node -e \"const fs=require('fs');const s='../backend/src/data/geonames',d='src/lib/data/geonames';fs.mkdirSync(d,{recursive:true});for(const f of['countries.json','cities.json'])fs.copyFileSync(s+'/'+f,d+'/'+f)\"",
    "dev": "npm run setup && vite dev",
    "build": "npm run setup && vite build",
    "preview": "vite preview",
    "codegen": "npm run setup && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale",
    "check": "npm run codegen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "npm run codegen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:smoke": "playwright test --config playwright.smoke.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.1",
    "@types/qrcode": "^1.5.6",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@dragdroptouch/drag-drop-touch": "^2.0.3",
    "@inlang/paraglide-js": "^2.19.0",
    "@lucide/svelte": "^1.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "dompurify": "^3.4.10",
    "idb": "^8.0.3",
    "marked": "^18.0.5",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "svelte": "^5.43.4"
  },
  "overrides": {
    "esrap": ">=2.2.11"
  }
}
