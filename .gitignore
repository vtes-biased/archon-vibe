INCOMING/

# Claude Code (user-specific settings and private memory)
.claude/settings.local.json
.claude/projects/
# `memory: project` resolves `.claude/agent-memory/` relative to cwd, so an agent
# run from a package subdir would otherwise write strays there. Each subdir's
# `.claude/agent-memory` is a committed symlink back to the root one (../../.claude/
# agent-memory), so subdir-cwd writes land in the tracked root memory. Keep per-subdir
# local settings out of the tree:
/*/.claude/settings.local.json

# Ansible
ansible/build/
ansible/.ansible_facts/
ansible/.ansible/

# Ansible vault — decrypted vault passwords, never commit (CI writes .vault_pass in
# the runner; admins decrypt secrets/<env>.vault-pass.age into the per-env files).
ansible/.vault_pass
ansible/.beta.vault_pass
ansible/.prod.vault_pass

# ansible/secrets/ — commit ONLY the public recipients list + age-encrypted password
# files; everything else (e.g. a decrypted plaintext password) stays ignored.
ansible/secrets/*
!ansible/secrets/age-recipients.txt
!ansible/secrets/*.vault-pass.age

# Role secret files — commit only the ansible-vault (.vault) variants, never plaintext.
ansible/roles/fastapi_backend/files/officials_contacts.json
ansible/roles/fastapi_backend/files/twda_github_app.pem
ansible/roles/fastapi_backend/files/feedback_github_app.pem
ansible/*.retry
ansible/galaxy_collections/

# Local prod DB dump for migration dry-runs (never commit)
archondb.dump.gz
*.dump.gz

# Personal data (scraped NC/Prince contacts) — never commit plaintext.
# Dev keeps an untracked copy here; prod gets it via ansible-vault at deploy.
backend/src/data/officials_contacts.json
