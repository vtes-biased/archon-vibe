# Patterns anchor at the context root — bare `node_modules/` never matched
# `frontend/node_modules`. Anything nested needs `**/`, which also matches the root.

# Git
.git
.gitignore

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Documentation
README.md
ARCHITECTURE.md

# IDE
.cursor
.vscode
.idea

# Python
**/__pycache__
**/*.py[cod]
*$py.class
*.so
.Python
.venv
venv/
ENV/
env/

# Node
**/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Rust - exclude most build artifacts but keep the ones we need for Docker
engine/target/debug/
engine/target/release/build/
engine/target/release/deps/
engine/target/release/examples/
engine/target/release/incremental/
engine/target/release/.fingerprint/
engine/target/CACHEDIR.TAG
engine/target/wheels/
engine/Cargo.lock
# Note: engine/pkg/ is INCLUDED for Docker builds (frontend WASM)

# Frontend — the image installs and generates its own; the host's copies would be
# layered over them by `COPY frontend/ ./`. geonames stays out because
# frontend/Dockerfile.test supplies it from backend/src/data/.
frontend/build/
frontend/.svelte-kit/
frontend/src/lib/paraglide/
frontend/src/lib/data/geonames/

# Test artifacts
**/test-results
**/playwright-report
**/.e2e-state.json

# OS
.DS_Store
Thumbs.db

# Development
justfile

