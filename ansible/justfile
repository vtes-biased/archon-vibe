# Archon ansible deploy — remote provision/deploy entrypoints.
# Run from this directory: `just deploy-beta`, `just bootstrap-prod`, … (dev tasks
# live in the repo-root justfile).
#
# Deployed artifacts are built by GitHub Actions and attached to the published
# Release; the deploy playbook fetches them itself, so the servers never run
# cargo/maturin/npm/uv. `just deploy-*` is a friendly wrapper over ansible-playbook;
# the build-* recipes are for local dev / `SOURCE=local` deploys.
#
# Env-var overrides (prefix the command): RELEASE_TAG=vX.Y.Z, SOURCE=local,
# FULL=1, REBOOT=1, QUICK=1 (deploys: artifacts only via --tags app — skips the
# provisioning roles; use a full deploy for any nginx/TLS/db/unit change).

repo_root := parent_directory(justfile_directory())
build_dir := justfile_directory() / "build"
manylinux := "quay.io/pypa/manylinux_2_28_x86_64"

# Deploy/provision recipes default ANSIBLE_VAULT_PASSWORD_FILE to the env's
# ansible/.<env>.vault_pass when you haven't set it yourself (an already-set value —
# your global, or CI's — is respected). Locally: decrypt secrets/<env>.vault-pass.age
# into it first (see README "Vault passwords"); CI writes its own file from the GitHub
# Environment secret. lint/build recipes are left out so they run with no password.
vault_pass_beta := justfile_directory() / ".beta.vault_pass"
vault_pass_prod := justfile_directory() / ".prod.vault_pass"

# Phase-1 parallel run: serve prod at new.archon.vekn.net with push off (extra-vars
# beat group_vars, so prod's vars.yml stays prod-final). Blank this line at the
# Phase-2 flip to revert to archon.vekn.net + push on. The file lives OUTSIDE
# inventories/prod/ on purpose — a vars file inside the `-i` dir gets mis-parsed
# as an inventory source. See ../.pst/details/39-phase1-parallel-run.md
phase1_override := "-e @inventories/prod-phase1-override.yml"

default:
    @just --list

# Install Ansible collection dependencies (incl. the server-setup foundation;
# git-sourced collections always reinstall, so new server-setup commits are
# picked up on every run while the pin stays on a branch)
galaxy:
    uv run --project {{repo_root}} ansible-galaxy collection install -r requirements.yml -p galaxy_collections

# Remove local build artifacts
clean:
    rm -rf {{build_dir}}
    mkdir -p {{build_dir}}

# Build the PyO3 engine wheel for linux x86_64 (manylinux_2_28, cp313)
build-engine-wheel:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p {{build_dir}}
    cd {{repo_root}} && python scripts/update_cards.py
    # manylinux_2_28 ships pythons at /opt/python/cp3XX-cp3XX/bin/python3.XX (not on
    # PATH), so we pass the full path. Both servers run the same uv-managed 3.13.
    docker run --rm --platform=linux/amd64 \
      -v {{repo_root}}:/io \
      -w /io/engine \
      {{manylinux}} \
      bash -c "curl -LsSf https://astral.sh/uv/install.sh | sh && \
               /root/.local/bin/uv tool install maturin && \
               /root/.local/bin/maturin build --release \
                 --compatibility manylinux_2_28 \
                 --interpreter /opt/python/cp313-cp313/bin/python3.13 \
                 --out /io/ansible/build"

# Build the backend wheel + export pinned requirements
build-backend:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p {{build_dir}}
    cd {{repo_root}} && uv build --wheel --out-dir {{build_dir}}
    cd {{repo_root}} && uv export --frozen --no-dev --no-hashes --no-emit-project \
      -o {{build_dir}}/backend-requirements.txt

# Build the bot wheel + export pinned requirements
build-bot:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p {{build_dir}}
    cd {{repo_root}}/bot && uv build --wheel --out-dir {{build_dir}}
    cd {{repo_root}}/bot && uv export --frozen --no-dev --no-hashes --no-emit-project \
      -o {{build_dir}}/bot-requirements.txt

# Build the Svelte/Vite PWA (static dist)
build-frontend:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p {{build_dir}}
    cd {{repo_root}}/frontend && npm ci && npm run build
    rm -rf {{build_dir}}/frontend-dist
    cp -R {{repo_root}}/frontend/build {{build_dir}}/frontend-dist

# Build every deployable artifact
build-all: build-engine-wheel build-backend build-bot build-frontend

# Beta has no bootstrap: server-setup owns the frankfurt foundation, and
# `just deploy-beta` is the only beta entrypoint.

# On the shared legacy VPS the bring-up MUST be sequenced foundation-prod ->
# migrate-postgres-prod -> database-prod -> deploy-prod, or site.yml's database
# step runs before the PG16->17 migration and hits the two-cluster trap.
# Prod foundation only (common role: packages+psycopg2, archon user, dirs, uv, nginx, ufw)
foundation-prod: galaxy
    ANSIBLE_VAULT_PASSWORD_FILE="${ANSIBLE_VAULT_PASSWORD_FILE:-{{vault_pass_prod}}}" uv run --project {{repo_root}} ansible-playbook -i inventories/prod playbooks/bootstrap.yml

# Dry-run (check mode) of the foundation only — review before foundation-prod
dry-foundation-prod: galaxy
    ANSIBLE_VAULT_PASSWORD_FILE="${ANSIBLE_VAULT_PASSWORD_FILE:-{{vault_pass_prod}}}" uv run --project {{repo_root}} ansible-playbook -i inventories/prod playbooks/bootstrap.yml --check --diff

# Greenfield one-shot of a CLEAN box (foundation+db+deploy via site.yml); NOT the shared legacy VPS
bootstrap-prod: galaxy
    ANSIBLE_VAULT_PASSWORD_FILE="${ANSIBLE_VAULT_PASSWORD_FILE:-{{vault_pass_prod}}}" uv run --project {{repo_root}} ansible-playbook -i inventories/prod {{phase1_override}} playbooks/site.yml

# Beta's DB/role is created by deploy-beta.yml via server-setup's postgres_db role.
# Install/configure PostgreSQL + archon DB/user on prod
database-prod:
    ANSIBLE_VAULT_PASSWORD_FILE="${ANSIBLE_VAULT_PASSWORD_FILE:-{{vault_pass_prod}}}" uv run --project {{repo_root}} ansible-playbook -i inventories/prod playbooks/database.yml

# Deploy archon-vibe to beta/frankfurt (RELEASE_TAG=… / SOURCE=local / QUICK=1)
deploy-beta:
    #!/usr/bin/env bash
    set -euo pipefail
    export ANSIBLE_VAULT_PASSWORD_FILE="${ANSIBLE_VAULT_PASSWORD_FILE:-{{vault_pass_beta}}}"
    extra=""
    if [ -n "${RELEASE_TAG:-}" ]; then extra="-e release_tag=${RELEASE_TAG}"; fi
    if [ "${SOURCE:-}" = local ]; then just build-all; extra="$extra -e artifact_source=local"; fi
    if [ -n "${QUICK:-}" ]; then extra="$extra --tags app"; fi
    uv run --project {{repo_root}} ansible-playbook -i inventories/beta playbooks/deploy-beta.yml $extra

# Deploy backend/frontend/bot to prod (RELEASE_TAG=… / SOURCE=local / QUICK=1)
deploy-prod:
    #!/usr/bin/env bash
    set -euo pipefail
    export ANSIBLE_VAULT_PASSWORD_FILE="${ANSIBLE_VAULT_PASSWORD_FILE:-{{vault_pass_prod}}}"
    extra=""
    if [ -n "${RELEASE_TAG:-}" ]; then extra="-e release_tag=${RELEASE_TAG}"; fi
    if [ "${SOURCE:-}" = local ]; then just build-all; extra="$extra -e artifact_source=local"; fi
    if [ -n "${QUICK:-}" ]; then extra="$extra --tags app"; fi
    uv run --project {{repo_root}} ansible-playbook -i inventories/prod {{phase1_override}} playbooks/deploy.yml $extra

# No beta variant: frankfurt system updates (apt + reboots) belong to server-setup.
# apt upgrade + (optional) reboot on prod (FULL=1 REBOOT=1)
upgrade-prod:
    #!/usr/bin/env bash
    set -euo pipefail
    export ANSIBLE_VAULT_PASSWORD_FILE="${ANSIBLE_VAULT_PASSWORD_FILE:-{{vault_pass_prod}}}"
    extra=""
    if [ -n "${FULL:-}" ]; then extra="-e upgrade_full=true"; fi
    if [ -n "${REBOOT:-}" ]; then extra="$extra -e upgrade_reboot=true"; fi
    uv run --project {{repo_root}} ansible-playbook -i inventories/prod playbooks/upgrade.yml $extra

# One-shot PG16 -> PG17 migration on prod (requires confirmation)
migrate-postgres-prod:
    ANSIBLE_VAULT_PASSWORD_FILE="${ANSIBLE_VAULT_PASSWORD_FILE:-{{vault_pass_prod}}}" uv run --project {{repo_root}} ansible-playbook -i inventories/prod playbooks/migrate_postgres.yml

# yamllint + ansible-lint on the ansible tree
lint: galaxy
    uv run --project {{repo_root}} yamllint -s .
    uv run --project {{repo_root}} ansible-lint

# Dry-run (check mode) of the beta deploy; the release fetch runs for real, localhost-only (RELEASE_TAG=… / SOURCE=local)
dry-deploy-beta: galaxy
    #!/usr/bin/env bash
    set -euo pipefail
    export ANSIBLE_VAULT_PASSWORD_FILE="${ANSIBLE_VAULT_PASSWORD_FILE:-{{vault_pass_beta}}}"
    extra=""
    if [ -n "${RELEASE_TAG:-}" ]; then extra="-e release_tag=${RELEASE_TAG}"; fi
    if [ "${SOURCE:-}" = local ]; then just build-all; extra="$extra -e artifact_source=local"; fi
    uv run --project {{repo_root}} ansible-playbook -i inventories/beta playbooks/deploy-beta.yml --check --diff $extra

# Dry-run (check mode) of site.yml against prod
dry-prod: galaxy
    ANSIBLE_VAULT_PASSWORD_FILE="${ANSIBLE_VAULT_PASSWORD_FILE:-{{vault_pass_prod}}}" uv run --project {{repo_root}} ansible-playbook -i inventories/prod {{phase1_override}} playbooks/site.yml --check --diff
