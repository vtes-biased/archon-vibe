[Unit]
Description=Weekly restore-verify of postgres backups
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
SyslogIdentifier=postgres-backup-check
Environment=BACKUP_DIR={{ r.backup_dir }}
{% if r.remote_enabled | default(false) | bool %}
EnvironmentFile=/etc/postgres-backup/remote.env
{% endif %}
# Dead-man's-switch ping URLs; the '-' tolerates the file being absent.
EnvironmentFile=-/etc/postgres-backup/healthcheck.env
# Shared 1-vCPU box: the pg_restore round-trip should never crowd the apps.
Nice=10
IOSchedulingClass=idle
ExecStart=/usr/local/bin/pg-backup-check
