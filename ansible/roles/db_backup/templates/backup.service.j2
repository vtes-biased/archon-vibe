[Unit]
Description=pg_dump backup of every database in the cluster
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
SyslogIdentifier=postgres-backup
Environment=BACKUP_DIR={{ _backup_dir }}
Environment=RETENTION_DAYS={{ _retention_days }}
Environment="EXCLUDE_DBS={{ _exclude | join(' ') }}"
{% if _remote_enabled | bool %}
EnvironmentFile=/etc/postgres-backup/remote.env
{% endif %}
# Dead-man's-switch ping URLs; the '-' tolerates the file being absent.
EnvironmentFile=-/etc/postgres-backup/healthcheck.env
# Shared 1-vCPU box: yield to the live apps (pg_dump's compression is
# client-side CPU; the dumps themselves are small, ~tens of MB).
Nice=10
IOSchedulingClass=idle
ExecStart=/usr/local/bin/pg-backup
