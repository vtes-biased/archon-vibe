[Unit]
Description=archon legacy-archon to archon-vibe merge ({{ _service_name }})
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User={{ r.user }}
Group={{ r.group }}
EnvironmentFile={{ _env_dir }}/{{ _service_name }}.env
# Heavy one-shot on a memory-tight box — run gently so legacy + backend stay
# responsive (the merge spikes RAM/IO during its pg_dump + bulk upserts).
Nice=10
IOSchedulingClass=idle
# Both stacks share one PG17 cluster, so an OOM-kill of postgres would take
# down legacy too — make the merge the guaranteed victim instead.
OOMScoreAdjust=800
MemoryHigh=400M
MemoryMax=600M
# oneshot disables the start timeout by default; pin it so a long merge is never SIGTERM'd.
TimeoutStartSec=infinity
ExecStart={{ r.site_root }}/.venv/bin/python {{ r.site_root }}/scripts/migrate_from_archon.py --merge
