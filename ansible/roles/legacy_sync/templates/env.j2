# Rendered by ansible; do not edit.
# OLD (read-only): peer auth — pg_hba has no scram line for {{ r.legacy_db_name }}.
OLD_DATABASE_URL=host=/var/run/postgresql dbname={{ r.legacy_db_name }} user={{ r.legacy_db_user }}
# NEW: scram (db owner). Keyword conninfo, password single-quoted + backslash-escaped
# per libpq so any char (space/quote/backslash/URL-special) is safe.
NEW_DATABASE_URL=host=/var/run/postgresql dbname={{ r.new_db_name }} user={{ r.new_db_user }} password='{{ r.new_db_password | replace("\\", "\\\\") | replace("'", "\\'") }}'
MERGE_BACKUP_DIR={{ _merge_backup_dir }}
