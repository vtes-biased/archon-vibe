server {
  # http2 as a listen param, not the standalone `http2 on;` directive — the
  # latter needs nginx >= 1.25.1; the prod box runs 1.24 (Ubuntu 24.04).
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name {{ r.server_name }};

  ssl_certificate         /etc/letsencrypt/live/{{ r.server_name }}/fullchain.pem;
  ssl_certificate_key     /etc/letsencrypt/live/{{ r.server_name }}/privkey.pem;
  ssl_trusted_certificate /etc/letsencrypt/live/{{ r.server_name }}/fullchain.pem;

  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  # Uniquely named zone: legacy archon on this box declares shared:SSL (a
  # different size), and same-name/different-size aborts nginx -t.
  ssl_session_cache shared:archonvibe_ssl:10m;
  ssl_session_timeout 5m;
  ssl_stapling on;
  ssl_stapling_verify on;

  access_log syslog:server=unix:/dev/log,nohostname;
  error_log syslog:server=unix:/dev/log,nohostname;

  client_max_body_size 1k;

  add_header X-Frame-Options "DENY" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  # The streams are the bulk of the egress and go out uncompressed without this;
  # gzip_proxied defaults to off, which would skip every proxied response.
  gzip on;
  gzip_vary on;
  gzip_proxied any;
  gzip_min_length 1024;
  gzip_types application/json application/x-ndjson;

  limit_conn {{ _zone }}_conn 16;
  # nginx defaults both to 503, which tells a client "outage, retry" rather than
  # "slow down".
  limit_req_status 429;
  limit_conn_status 429;

  # Inherited by every location below: a location that declares any
  # proxy_set_header of its own drops all of these.
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Host $http_host;
  proxy_http_version 1.1;
  # Taking the first N lines and hanging up is the documented top-N idiom;
  # buffering would make that reader wait for the whole corpus.
  proxy_buffering off;
  proxy_read_timeout 300s;

  location = / {
    return 302 /docs;
  }

  # Proxied to the app, at the app's own path: a third party never types a
  # second hostname, and a rewritten path here would drift from `banner_path`.
{% for path in ['= /oauth/token', '= /oauth/revoke'] %}
  location {{ path }} {
    limit_req zone={{ _zone }}_token burst=5 nodelay;
    proxy_pass http://127.0.0.1:{{ r.backend_port }};
  }
{% endfor %}
  location ~ ^/api/tournaments/[0-9a-fA-F-]+/banner$ {
    limit_req zone={{ _zone }}_read burst=100 nodelay;
    proxy_pass http://127.0.0.1:{{ r.backend_port }};
  }

{% for path in ['/docs', '/openapi.json'] %}
  location = {{ path }} {
    limit_req zone={{ _zone }}_read burst=100 nodelay;
    proxy_pass http://127.0.0.1:{{ r.port }};
  }
{% endfor %}

  # The streaming surface, exact-match so a single-object lookup under the same
  # prefix falls through to the generous zone below.
{% for path in ['/v1/tournaments', '/v1/leagues', '/v1/decks', '/v1/users', '/v1/community-links', '/v1/export'] %}
  location = {{ path }} {
    limit_req zone={{ _zone }}_stream burst=10 nodelay;
    proxy_pass http://127.0.0.1:{{ r.port }};
  }
{% endfor %}

  location /v1/ {
    limit_req zone={{ _zone }}_read burst=100 nodelay;
    proxy_pass http://127.0.0.1:{{ r.port }};
  }

  location / {
    return 404;
  }
}
