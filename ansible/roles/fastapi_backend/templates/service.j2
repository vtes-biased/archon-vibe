[Unit]
Description={{ r.service_name }} (archon FastAPI backend)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User={{ r.user }}
Group={{ r.group }}
WorkingDirectory={{ r.site_root }}
EnvironmentFile={{ _env_dir }}/{{ r.service_name }}.env
ExecStart={{ _venv_dir }}/bin/uvicorn --host 127.0.0.1 --port {{ r.port }} --log-level info --timeout-graceful-shutdown 5 {{ _asgi_entrypoint }}
# A 200-client burst costs a socket plus a snapshot fd per client, under 2x
# headroom at the 1024 default — running out truncates responses mid-body.
LimitNOFILE=65536
Restart=always
RestartSec=3
TimeoutStartSec=30
# Daily restart: primarily to re-fetch upstream assets loaded at startup
# (krcg-static card data) without a redeploy; also a low-key memory-leak defense.
RuntimeMaxSec=1d
# Bounds the worst case if a connection ignores both SIGTERM and the 5s
# graceful-shutdown drain (was a ~90s hang via the default 90s TimeoutStopSec).
TimeoutStopSec=15
KillMode=mixed

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths={{ r.site_root }} {{ _data_dir }}

[Install]
WantedBy=multi-user.target
