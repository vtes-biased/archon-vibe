# Social link-preview crawlers — curated to *preview* bots (NOT search engines:
# Googlebot/Bingbot render JS and must index the real SPA route). An unlisted new
# crawler just gets the site-wide card; drift degrades gracefully. Ground truth:
# github.com/monperrus/crawler-user-agents. Lives in http context (above server{}).
map $http_user_agent $is_social_bot {
  default 0;
  "~*facebookexternalhit|Facebot|meta-externalagent|Twitterbot|Discordbot|redditbot|Slackbot|Slack-ImgProxy|TelegramBot|WhatsApp|LinkedInBot|Pinterest|SkypeUriPreview|vkShare|Embedly|Iframely|FlipboardProxy|Bluesky|Mastodon|Applebot" 1;
}

server {
  # http2 as a listen param, not the standalone `http2 on;` directive — the
  # latter needs nginx >= 1.25.1; the prod box runs 1.24 (Ubuntu 24.04).
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name {{ r.server_name }};

  ssl_certificate         /etc/letsencrypt/live/{{ r.server_name }}/fullchain.pem;
  ssl_certificate_key     /etc/letsencrypt/live/{{ r.server_name }}/privkey.pem;
  ssl_trusted_certificate /etc/letsencrypt/live/{{ r.server_name }}/fullchain.pem;

  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  # Uniquely named zone: legacy archon on this box declares shared:SSL (a
  # different size), and same-name/different-size aborts nginx -t.
  ssl_session_cache shared:archonvibe_ssl:10m;
  ssl_session_timeout 5m;
  ssl_stapling on;
  ssl_stapling_verify on;

  access_log syslog:server=unix:/dev/log,nohostname;
  error_log syslog:server=unix:/dev/log,nohostname;

  root {{ _dist_dir }};
  index index.html;
  charset utf-8;
  client_max_body_size {{ _client_max_body }};

  # Security headers
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  # gzip
  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_types
    text/css text/javascript text/xml text/plain
    application/javascript application/json application/xml application/rss+xml application/wasm
    font/truetype font/opentype
    image/svg+xml;
  gzip_static on;

  # ---- backend reverse proxy (same origin) ------------------------------
  # Same-origin is load-bearing for the sync handshake: the client reads the
  # /snapshot `X-Access-Version` response header (the per-user access fingerprint).
  # A split-origin deploy would need `Access-Control-Expose-Headers: X-Access-Version`
  # here (mind nginx add_header inheritance — re-add the server-level security headers).
{% for path in _backend_paths %}
  location {{ path }} {
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
    proxy_pass http://127.0.0.1:{{ r.backend_port }};
  }
{% endfor %}

  # ---- SSE stream: buffering off, long read timeout, no gzip ------------
  location {{ _sse_path }} {
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_set_header Connection '';
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1d;
    gzip off;
    chunked_transfer_encoding on;
    proxy_pass http://127.0.0.1:{{ r.backend_port }};
  }

  # ---- Tournament share links: UA-split for og:image --------------------
  # Humans get the static SPA shell (offline/SW intact); social crawlers are
  # proxied to FastAPI's per-tournament og stub (they don't run JS, so the SPA's
  # client-set meta is invisible to them). `if`+`return` is the safe escape from
  # a location (NOT proxy_pass inside if); the named @og_stub does the proxy.
  # Only the bare /tournaments/{uid} share URL — sub-routes fall through to SPA.
  location ~ ^/tournaments/[0-9a-fA-F-]+$ {
    error_page 418 = @og_stub;
    if ($is_social_bot) { return 418; }
    try_files $uri $uri.html /200.html;
    add_header Cache-Control "public, must-revalidate, max-age=0";
  }
  location @og_stub {
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
    proxy_pass http://127.0.0.1:{{ r.backend_port }};
  }

  # ---- PWA caching rules ------------------------------------------------
  # Service worker files: never cache
  location ~ ^/(sw|registerSW|workbox-).*\.js$ {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
  }

  # Vite immutable hashed assets
  location ^~ /_app/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }
  location ^~ /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # PWA manifest: short TTL
  location = /manifest.webmanifest {
    types { application/manifest+json webmanifest; }
    add_header Cache-Control "public, must-revalidate, max-age=3600";
  }

  # Images, icons: moderate cache
  location ~* \.(?:jpg|jpeg|png|svg|gif|webp|ico|avif)$ {
    add_header Cache-Control "public, must-revalidate, max-age=3600";
  }

  # HTML / JSON / CSS: always revalidate
  location ~* \.(?:html|css|json)$ {
    add_header Cache-Control "public, must-revalidate, max-age=0";
  }

  # SPA fallback. adapter-static emits prerendered routes as `<route>.html` (and
  # nested dirs like tournaments/ for /tournaments/new), so try `$uri.html` for a
  # clean URL, then fall back to the SPA shell `200.html`. Deliberately NO `$uri/`
  # term: it would match the bare tournaments/ dir (no index.html inside) and
  # nginx would 403 instead of booting the client router.
  location / {
    try_files $uri $uri.html /200.html;
    add_header Cache-Control "public, must-revalidate, max-age=0";
  }
}
