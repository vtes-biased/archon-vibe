---
# See https://ansible.readthedocs.io/projects/lint/configuring/

profile: production

# Collections resolve via ansible.cfg's collections_path (pre-installed by
# `just galaxy`) — no need to re-download requirements.yml into .ansible/.
offline: true

exclude_paths:
  - build/
  - .ansible/
  - .ansible_facts/
  - .cache/
  - galaxy_collections/     # third-party collections installed via `just galaxy`
  - inventories/beta/group_vars/vault.yml
  - inventories/prod/group_vars/vault.yml

# A single `r` dict is passed into parameterised roles rather than prefixing
# every variable, so a role can be invoked twice with different inputs.
skip_list:
  - var-naming[no-role-prefix]
