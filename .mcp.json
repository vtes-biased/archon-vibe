{
  "mcpServers": {
    "grafana-vtesbiased": {
      "type": "stdio",
      "command": "zsh",
      "args": [
        "-c",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN=\"$GRAFANA_TOKEN_VTESBIASED\" exec uvx mcp-grafana --disable-write"
      ],
      "env": {
        "GRAFANA_URL": "https://vtesbiased.grafana.net"
      }
    }
  }
}
